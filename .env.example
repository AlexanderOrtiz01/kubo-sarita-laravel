# NO se usa en Kubo: en producción todo viene de variables de entorno.
#  - APP_KEY, APP_NAME y APP_URL: las configura el cliente en el panel de Kubo (Variables de entorno)
#  - DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD: las inyecta Kubo
#    desde el Secret de la base de datos administrada (MySQL 8.4)
APP_NAME="Sorbetería Sarita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=es

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sarita
DB_USERNAME=sarita
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
LOG_CHANNEL=stderr
